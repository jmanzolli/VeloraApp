@article{ahmadi2024Optimizingurbanbikesharing,
	title = {Optimizing urban bike-sharing systems: a stochastic mathematical model for infrastructure planning},
	issn = {1613-9178},
	shorttitle = {Optimizing urban bike-sharing systems},
