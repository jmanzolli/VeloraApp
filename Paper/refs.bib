	file = {PDF:C\:\\Users\\nahmad29\\Zotero\\storage\\97FBGTES\\Dill and McNeil - 2013 - Four Types of Cyclists Examination of Typology for Better Understanding of Bicycling Behavior and.pdf:application/pdf},
}

